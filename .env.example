# ── LLM provider ──────────────────────────────────────────────────────────────
# Cần ÍT NHẤT một trong hai key. Provider dùng chung cho: generation
# (setup_answers.py), RAGAS judge (Phase A), LLM-as-Judge (Phase B) và
# NeMo Guardrails (Phase C).
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Chọn provider tường minh khi có cả hai key: openai | gemini | auto
# auto = ưu tiên Gemini nếu có GEMINI_API_KEY.
#
# KHUYẾN NGHỊ dùng openai nếu có key trả phí: Gemini free tier giới hạn
# 15 request/phút VÀ quota ngày rất thấp ở nhiều model (đo thực tế: 20 req/ngày với
# gemini-3.5-flash / 3.6-flash / 3-flash-preview; 500 req/ngày với 3.1-flash-lite).
# Phase A cần ~350 call nên rất dễ cạn quota giữa chừng.
LLM_PROVIDER=auto

# ── Model overrides (optional) ────────────────────────────────────────────────
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemma-4-31b-it
GEMINI_EMBED_MODEL=models/gemini-embedding-001
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# ── Rate limit / retry (optional) ─────────────────────────────────────────────
# Gemini free tier = 15 request/phút → giữ LLM_RPM=14.
# Với OpenAI trả phí có thể nâng lên 100-500 (tuỳ tier), hoặc 0 để tắt throttle.
LLM_RPM=14
LLM_MAX_RETRIES=3
LLM_TIMEOUT=90
RAGAS_MAX_WORKERS=4

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=hf_...
